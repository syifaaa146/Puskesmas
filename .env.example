PORT=5000
NODE_ENV=development

# --- Database (Turso / libSQL) ---------------------------------------------
# Buat database: `turso db create puskesmas-kutawaluya`
# Ambil URL     : `turso db show puskesmas-kutawaluya --url`
# Buat token    : `turso db tokens create puskesmas-kutawaluya`
# Untuk coba-coba lokal tanpa akun Turso, bisa isi:
#   TURSO_DATABASE_URL=file:local.db
# (dan kosongkan TURSO_AUTH_TOKEN)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- CORS --------------------------------------------------------------
# Kosongkan saat development (semua origin diizinkan). Untuk produksi di
# Vercel biasanya boleh dikosongkan juga karena frontend & backend satu
# domain, tapi bisa diisi eksplisit kalau perlu, dipisah koma:
# FRONTEND_URL=https://nama-domain-vercel.vercel.app
FRONTEND_URL=

# --- Email pengaduan (SMTP) ---------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=

# --- Autentikasi admin ---------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=
# Generate dengan: npm run hash-password -- "password_anda"
ADMIN_PASSWORD_HASH=

# --- Batas ukuran file ---------------------------------------------------
MAX_EXCEL_FILE_SIZE_MB=10
MAX_ATTACHMENT_FILE_SIZE_MB=5
